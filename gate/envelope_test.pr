use json;


_metrics() map[string, MetricValue] {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["test_count"] = MetricValue.Int(17703);
  m["test_failures"] = MetricValue.Int(0);
  return m;
}

envelope_encodes_as_one_object() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  string s = json.encode_string(out)?!;
  assert(s.contains("\"schema_version\":1"), msg: "carries its wire version");
  assert(s.contains("\"target\":\"linux/amd64\""), msg: "carries the target it speaks for");
  assert(!s.contains("\"complete\""), msg: "and no completeness field: it is derived from the reason, not written twice: " + s);
}

integer_metrics_stay_integers() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  string s = json.encode_string(out)?!;
  assert(s.contains("\"type\":\"Int\""), msg: "a count says it is one: " + s);
  assert(s.contains("\"value\":17703"), msg: "and carries the exact count: " + s);
  assert(!s.contains("17703.0"), msg: "no float widening of an exact count");
}

float_metrics_stay_floats() `test {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["build_seconds"] = MetricValue.Float(50.4);
  GateOutput out = GateOutput.of("darwin/arm64", move m);
  string s = json.encode_string(out)?!;
  assert(s.contains("\"type\":\"Float\""), msg: "a measured duration says it is one: " + s);
  assert(s.contains("50.4"), msg: "and keeps its fraction");
}

a_measured_type_survives_the_wire() `test {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["test_count"] = MetricValue.Int(5);
  m["load_average"] = MetricValue.Float(5.0);
  GateOutput out = GateOutput.of("linux/amd64", move m);
  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](s.clone())?!;
  map[string, MetricValue] read = back.metrics();
  MetricValue? count = read["test_count"];
  MetricValue? load = read["load_average"];
  assert(count is present, msg: "the count came back");
  assert(load is present, msg: "the load average came back");
  // Both measure 5. Written bare they would be one number, and whichever the
  // reader guessed would be right half the time.
  bool count_is_int = match count! { Int(_) => true, Float(_) => false };
  bool load_is_float = match load! { Int(_) => false, Float(_) => true };
  assert(count_is_int, msg: "an exact count is still an int after the round trip");
  assert(load_is_float, msg: "a float that lands on a whole number is still a float: " + s);
}

an_envelope_round_trips_whole() `test {
  map[string, MetricValue] g = map[string, MetricValue]();
  g["test_count"] = MetricValue.Int(300);
  GateOutput out = GateOutput.partial("linux/amd64", _metrics(), "wasm suite skipped: no wasmtime on this host")?!;
  out.with_group(MetricGroup.of("pkg/gate", move g));
  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](s.clone())?!;
  assert(back.target == "linux/amd64", msg: "the target survives");
  assert(back.schema_version == 1, msg: "the wire version survives");
  assert(!back.complete, msg: "and completeness is derived on the reading side, not carried");
  string? why = back.incomplete_reason();
  bool named = false;
  if why is present {
    named = why.contains("wasmtime");
  }
  assert(named, msg: "the reason survives");
  MetricGroup[] groups = back.groups();
  assert(groups.len == 1, msg: "the group survives");
  assert(groups[0].name == "pkg/gate", msg: "with its name");
}

groups_carry_per_part_measurements() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  map[string, MetricValue] g = map[string, MetricValue]();
  g["test_count"] = MetricValue.Int(164);
  out.with_group(MetricGroup.of("modules/json", move g));
  string s = json.encode_string(out)?!;
  assert(s.contains("\"modules/json\""), msg: "the group is named");
  assert(s.contains("164"), msg: "the group's own measurement is carried");
}

an_envelope_reports_no_verdict() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  string s = json.encode_string(out)?!;
  assert(!s.contains("\"status\""), msg: "no self-reported status");
  assert(!s.contains("\"verdict\""), msg: "no self-reported verdict");
  assert(!s.contains("\"passed\""), msg: "Reactor decides against caps and baselines, not the gate");
}

a_partial_run_says_so_and_says_why() `test {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["test_count"] = MetricValue.Int(3000);
  GateOutput out = GateOutput.partial("linux/amd64", move m, "wasm suite skipped: no wasmtime on this host")?!;
  assert(!out.complete, msg: "an incomplete run is marked");
  string? why = out.incomplete_reason();
  bool named = false;
  if why is present {
    named = why.contains("wasmtime");
  }
  assert(named, msg: "and says why, in the envelope, naming the cause");
  string s = json.encode_string(out)?!;
  assert(s.contains("wasmtime"), msg: "the reason crosses the wire");
  assert(!s.contains("\"complete\""), msg: "carried as the reason alone, so the wire cannot say complete and give a reason not to be: " + s);
}

a_complete_run_carries_no_reason() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  assert(out.complete, msg: "a full run is complete");
  string? why = out.incomplete_reason();
  assert(!(why is present), msg: "and has nothing to explain");
  string j = json.encode_string(out)?!;
  assert(!j.contains("incomplete_reason"), msg: "and the key is absent on the wire, not empty: " + j);
}

an_incomplete_run_with_nothing_to_say_is_refused() `test {
  bool right_reason = false;
  GateOutput out = GateOutput.partial("linux/amd64", _metrics(), "") ? e {
    right_reason = e.message.contains("must say why");
    GateOutput.of("linux/amd64", _metrics());
  };
  assert(right_reason, msg: "completeness is the reason's absence, so a blank one means nothing");
}

the_wire_is_held_to_the_same_rule() `test {
  // A derived decode builds the type field by field rather than through a
  // factory (promise-language/promise#45), so the wire can carry a state the
  // factories refuse. validate is where a decoded envelope meets that rule.
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[],\"incomplete_reason\":\"\"\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  assert(!back.complete, msg: "decode built an incomplete run with nothing to say");
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("must say why");
  };
  assert(right_reason, msg: "and validate refuses it");
}

a_nameless_envelope_is_refused() `test {
  string wire = "\{\"schema_version\":1,\"target\":\"\",\"metrics\":\{\},\"groups\":[]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("no target");
  };
  assert(right_reason, msg: "a verdict that speaks for no target speaks for nothing");
}

a_sound_envelope_validates() `test {
  GateOutput out = GateOutput.partial("linux/amd64", _metrics(), "wasm suite skipped")?!;
  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](move s)?!;
  back.validate()?!;
  assert(back.target == "linux/amd64", msg: "and a whole one passes through untouched");
}

_one_test_file() MetricGroup {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["test_count"] = MetricValue.Int(3);
  m["test_failures"] = MetricValue.Int(1);
  MetricGroup group = MetricGroup.of("tests/std/bool_test.pr", move m);
  GroupMember passed = GroupMember.of("test_and", Outcome.Pass, none, 0.001);
  group.with_member(move passed);
  GroupMember failed = GroupMember.of("test_or", Outcome.Fail, "panic: assertion failed: 1 != 2", 0.002);
  group.with_member(move failed);
  GroupMember excluded = GroupMember.of("test_wasm", Outcome.Excluded, none, none);
  group.with_member(move excluded);
  return group;
}

a_group_carries_its_members() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(_one_test_file());
  string s = json.encode_string(out)?!;
  assert(s.contains("\"name\":\"test_or\""), msg: "a member is named: " + s);
  assert(s.contains("\"outcome\":\"fail\""), msg: "and says how it turned out, in the wire spelling: " + s);
  assert(s.contains("panic: assertion failed"), msg: "and carries what explained it — which the metrics map has nowhere to put: " + s);
  assert(s.contains("\"elapsed\":0.002"), msg: "and how long it took, which is what finds the one test that got slow: " + s);
  assert(s.contains("\"outcome\":\"excluded\""), msg: "a test not meant for this target is carried rather than dropped: " + s);
  assert(!s.contains("null"), msg: "an absent detail or elapsed is an absent key, not a null: " + s);
}

// The member's outcome in its wire spelling. An envelope that has been through
// validate has one on every member, so the marker below stands for a state
// these tests should never see rather than for a member legitimately without.
_spelling(GroupMember member) string {
  Outcome? outcome = member.outcome;
  if outcome is present {
    return outcome.to_string();
  }
  return "<no outcome>";
}

members_survive_the_wire() `test {
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(_one_test_file());
  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](move s)?!;
  back.validate()?!;
  MetricGroup[] groups = back.groups();
  assert(groups.len == 1, msg: "the group survives");
  MetricGroup group = groups[0];
  GroupMember[] members = group.members();
  assert(members.len == 3, msg: "with all three of its members");

  GroupMember first = members[0];
  assert(first.name == "test_and", msg: "in the order the gate reported them");
  assert(_spelling(first) == "pass", msg: "with its outcome");
  string? no_detail = first.detail();
  assert(!(no_detail is present), msg: "a pass that needed no explaining carries none");
  // A tolerance rather than equality, and the gap is not this type's: the json
  // module's number parser is one ULP high on 0.001 and 0.002 (#38), so no
  // float survives this wire exactly. When that closes this asserts ==.
  f64? timed = first.elapsed();
  bool timed_right = false;
  if timed is present {
    f64 off = timed - 0.001;
    timed_right = off < 0.000001 && off > -0.000001;
  }
  assert(timed_right, msg: "and its duration, as measured");

  GroupMember second = members[1];
  assert(_spelling(second) == "fail", msg: "the failure is still a failure");
  string? why = second.detail();
  bool explained = false;
  if why is present {
    explained = why.contains("assertion failed");
  }
  assert(explained, msg: "and the panic that explains it survived the boundary it used to be discarded at");

  GroupMember third = members[2];
  assert(_spelling(third) == "excluded", msg: "an exclusion is a decision, and it comes back as one");
  f64? untimed = third.elapsed();
  assert(!(untimed is present), msg: "and a thing the subject never timed reports no duration rather than zero");
}

_every_outcome() Outcome[] {
  Outcome[] all = Outcome[]();
  all.push(Outcome.Pass);
  all.push(Outcome.Fail);
  all.push(Outcome.Timeout);
  all.push(Outcome.Leak);
  all.push(Outcome.Memory);
  all.push(Outcome.Excluded);
  all.push(Outcome.NotRun);
  return all;
}

_every_spelling() string[] {
  string[] all = string[]();
  all.push("pass");
  all.push("fail");
  all.push("timeout");
  all.push("leak");
  all.push("memory");
  all.push("excluded");
  all.push("not-run");
  return all;
}

every_outcome_spelling_round_trips() `test {
  // encode writes the spelling and decode reads it back — the pair is the
  // contract, and it is written by hand so that a gate in another language
  // meets `not-run` rather than the variant's Promise name.
  Outcome[] all = _every_outcome();
  string[] spellings = _every_spelling();
  map[string, MetricValue] empty = map[string, MetricValue]();
  MetricGroup group = MetricGroup.of("every-outcome", move empty);
  int i = 0;
  while i < all.len {
    Outcome one = all[i];
    string spelling = spellings[i];
    GroupMember m = GroupMember.of(move spelling, move one, none, none);
    group.with_member(move m);
    i = i + 1;
  }
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(move group);
  string s = json.encode_string(out)?!;

  // What is on the wire, before what comes back off it. A derived pair writes
  // the variant's Promise name and reads that same name back, so a round trip
  // alone passes on `NotRun` — the one spelling the hand-written encode exists
  // for. Only the text says which of the two a gate in another language meets.
  bool every_spelling_written = true;
  int w = 0;
  while w < spellings.len {
    string want = spellings[w];
    if !s.contains("\"outcome\":\"" + want + "\"") {
      every_spelling_written = false;
    }
    w = w + 1;
  }
  assert(every_spelling_written, msg: "every outcome is on the wire in its own spelling, not its variant's name: " + s);

  GateOutput back = json.decode_string[GateOutput](s.clone())?!;
  MetricGroup[] groups = back.groups();
  MetricGroup read = groups[0];
  GroupMember[] members = read.members();
  assert(members.len == 7, msg: "every outcome crossed the wire: " + s);
  bool every_one = true;
  int j = 0;
  while j < members.len {
    GroupMember m = members[j];
    string want = spellings[j];
    string got = _spelling(m);
    if got != want {
      every_one = false;
    }
    if m.name != want {
      every_one = false;
    }
    j = j + 1;
  }
  assert(every_one, msg: "and each came back as the outcome it went out as: " + s);
}

an_unknown_outcome_is_refused() `test {
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"name\":\"test_or\",\"outcome\":\"passed\"\}]\}]\}";
  string refusal = "";
  json.decode_string[GateOutput](move wire) ? e {
    refusal = e.message.clone();
    GateOutput.of("linux/amd64", _metrics());
  };
  assert(refusal.contains("unknown outcome 'passed'"),
         msg: "a spelling outside the closed set is refused at the boundary, not missed at a lookup: " + refusal);
  assert(refusal.contains("pass, fail, timeout, leak, memory, excluded, or not-run"),
         msg: "and the refusal says what was allowed instead, which is the whole reason the set is closed: " + refusal);
}

a_member_with_no_name_is_refused() `test {
  // Written as wire rather than built: a derived decode constructs the type
  // field by field rather than through a factory (promise-language/promise#45),
  // so validate is where a decoded member meets the rule.
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"name\":\"\",\"outcome\":\"fail\"\}]\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("has no name") && e.message.contains("pkg/gate");
  };
  assert(right_reason, msg: "a member that names nothing says nothing, and the message names the group it was in");
}

a_member_with_no_outcome_is_refused() `test {
  // The one required field on a member whose type has no empty value to arrive
  // as, so this is the case that decides whether a gate in another language
  // omitting it is refused or takes the reading process down with it: the
  // envelope has to hold the absence long enough for validate to name it.
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"name\":\"test_or\",\"detail\":\"panic\"\}]\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("reports no outcome") && e.message.contains("test_or");
  };
  assert(right_reason, msg: "a member that never says how its thing turned out is refused, and the message names it");
}

a_detail_with_nothing_to_say_is_refused() `test {
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"name\":\"test_or\",\"outcome\":\"fail\",\"detail\":\"\"\}]\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("explains nothing") && e.message.contains("test_or");
  };
  assert(right_reason, msg: "a detail is carried to explain a bad outcome, so an empty one is the state it cannot mean");
}

a_negative_elapsed_is_refused() `test {
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"name\":\"test_or\",\"outcome\":\"pass\",\"elapsed\":-1.0\}]\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  bool right_reason = false;
  back.validate() ? e {
    right_reason = e.message.contains("negative time") && e.message.contains("test_or");
  };
  assert(right_reason, msg: "nothing took less than no time");
}

a_group_without_members_is_whole() `test {
  map[string, MetricValue] m = map[string, MetricValue]();
  m["test_count"] = MetricValue.Int(164);
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(MetricGroup.of("modules/json", move m));
  out.validate()?!;
  MetricGroup[] built = out.groups();
  MetricGroup one = built[0];
  assert(one.members().len == 0, msg: "a gate reporting only its per-part totals is reporting what it measured");

  // The wire evolves additively, so an envelope from a gate that has never
  // heard of members reads here as a group with none, rather than failing.
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"modules/json\",\"metrics\":\{\}\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  back.validate()?!;
  MetricGroup[] groups = back.groups();
  assert(groups.len == 1, msg: "the group still reads");
  MetricGroup read = groups[0];
  assert(read.name == "modules/json", msg: "with its name");
  assert(read.members().len == 0, msg: "and an absent members key is no members, not a refusal");
}

_sound_member(string move name) GroupMember {
  return GroupMember.of(move name, Outcome.Pass, none, 0.5);
}

every_member_of_every_group_is_checked() `test {
  // Each rule above is exercised on a lone member of a lone group, which a
  // validate that read only the first member of the first group would satisfy
  // exactly as well. Here the bad entry is the second member of the second
  // group, so reaching it at all is what is being asserted — a run that reports
  // one test file is the small case, and the one an envelope is refused over is
  // the large one.
  map[string, MetricValue] wire_metrics = map[string, MetricValue]();
  MetricGroup first = MetricGroup.of("pkg/wire", move wire_metrics);
  first.with_member(_sound_member("identity_round_trips"));

  map[string, MetricValue] gate_metrics = map[string, MetricValue]();
  MetricGroup second = MetricGroup.of("pkg/gate", move gate_metrics);
  second.with_member(_sound_member("an_envelope_round_trips_whole"));
  GroupMember bad = GroupMember.of("test_slow", Outcome.Fail, "panic: assertion failed", -0.25);
  second.with_member(move bad);

  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(move first);
  out.with_group(move second);

  bool right_reason = false;
  out.validate() ? e {
    right_reason = e.message.contains("negative time")
                && e.message.contains("test_slow")
                && e.message.contains("pkg/gate");
  };
  assert(right_reason, msg: "the last member of the second group is held to the rule the first member of the first is, and the refusal says which entry it was");
}

a_member_too_fast_to_time_is_not_a_negative_one() `test {
  // The rule is on a negative elapsed, and zero is not negative: a thing that
  // finished inside the timer's resolution reports 0, and refusing that would
  // leave the envelope unable to carry the fastest thing it measures. Zero is
  // also the value an absent elapsed must not be confused with, which is the
  // distinction the second half checks.
  map[string, MetricValue] m = map[string, MetricValue]();
  MetricGroup group = MetricGroup.of("tests/std/bool_test.pr", move m);
  GroupMember instant = GroupMember.of("test_and", Outcome.Pass, none, 0.0);
  group.with_member(move instant);
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(move group);
  out.validate()?!;

  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](move s)?!;
  back.validate()?!;
  MetricGroup[] groups = back.groups();
  MetricGroup read = groups[0];
  GroupMember[] members = read.members();
  GroupMember timed_at_zero = members[0];
  f64? timed = timed_at_zero.elapsed();
  bool present_and_zero = false;
  if timed is present {
    present_and_zero = timed == 0.0;
  }
  assert(present_and_zero, msg: "a zero duration crosses as a duration, not as the absence that means the subject never timed it");
}

a_detail_crosses_the_wire_as_written() `test {
  // What a detail carries is a panic, and a real one has quotes, a colon and a
  // line break in it. The whole value of the field is that a reader sees what
  // the gate saw, so a character the encoding mangles on the way is this field
  // failing at the one job it has — and quietly, since a mangled panic still
  // reads as a panic.
  string said = "panic: assertion failed: \"and\" != \"or\"\n  at tests/std/bool_test.pr:42";
  map[string, MetricValue] m = map[string, MetricValue]();
  MetricGroup group = MetricGroup.of("tests/std/bool_test.pr", move m);
  GroupMember failed = GroupMember.of("test_or", Outcome.Fail, said.clone(), 0.5);
  group.with_member(move failed);
  GateOutput out = GateOutput.of("linux/amd64", _metrics());
  out.with_group(move group);

  string s = json.encode_string(out)?!;
  GateOutput back = json.decode_string[GateOutput](move s)?!;
  back.validate()?!;
  MetricGroup[] groups = back.groups();
  MetricGroup read = groups[0];
  GroupMember[] members = read.members();
  GroupMember one = members[0];
  string? why = one.detail();
  bool word_for_word = false;
  if why is present {
    word_for_word = why == said;
  }
  assert(word_for_word, msg: "a panic with quotes and a line break in it is what the reader gets back, character for character");
}

a_member_key_this_build_has_never_heard_of_is_ignored() `test {
  // The other half of the additive rule. a_group_without_members_is_whole reads
  // an envelope written before members existed; this one reads an envelope
  // written after this build, by a gate whose members carry a field this build
  // does not know. A reader that refused it would make every later addition to
  // a member a breaking change, which is the property the versioned wire is for.
  // The unknown keys sit on both sides of the known ones on purpose: skipping a
  // value and skipping it by exactly one value are the same thing to a reader
  // that stops at the first key it recognises.
  string wire = "\{\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\},\"groups\":[\{\"name\":\"pkg/gate\",\"metrics\":\{\},\"members\":[\{\"retries\":2,\"name\":\"test_or\",\"owner\":\{\"team\":\"std\"\},\"outcome\":\"fail\",\"tags\":[\"slow\"]\}]\}]\}";
  GateOutput back = json.decode_string[GateOutput](move wire)?!;
  back.validate()?!;
  MetricGroup[] groups = back.groups();
  MetricGroup read = groups[0];
  GroupMember[] members = read.members();
  assert(members.len == 1, msg: "the member reads");
  GroupMember one = members[0];
  assert(one.name == "test_or", msg: "with the name it was given");
  assert(_spelling(one) == "fail", msg: "and the outcome beside it, neither displaced by the keys around them");
}
