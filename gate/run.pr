use json;

// run.pr — executing one gate and reading what it reported.
//
// **The contract this implements is [docs/gate-contract.md](../docs/gate-contract.md)**,
// and that document is where it is stated: a gate is a subprocess printing one
// JSON envelope, the exec line is exec'd rather than interpreted, a gate is never
// invoked directly, and what a run amounted to is the runner's account of it
// rather than the gate's exit code. Restating any of that here would be a second
// copy to keep in sync, and the contract is language-neutral while this file is
// one language's implementation of it.
//
// What is here and not there: this runs a gate and decodes what it printed, and
// it decides nothing. The envelope carries measurements and never a verdict, and
// nothing in this module invents one — a caller holding the manifest and the
// baselines does that, because judging whether a number is acceptable is a
// different job from obtaining it.

use os;

type RunError is error `doc("A gate that printed something that is not an envelope. What became of a run is reported as its outcome rather than raised, so this says only what was wrong with what the gate printed, and run_gate turns it into the outcome the contract gives it — which is also why this is not public: it travels from the decode to that one handler and no further, and no caller of this module can ever be handed one.") {
}

_argv(string line) string[] `doc("Splits an exec line into program and arguments on whitespace. Deliberately not a shell grammar, and not an incomplete one either: no quoting is supported, because supporting quoting is the first step toward supporting everything else a shell does, and the contract requires that no host's shell can change what a line means.") {
  string[] parts = line.split(" ");
  string[] argv = string[]();
  int i = 0;
  while i < parts.len {
    string part = parts[i];
    if !part.is_empty {
      argv.push(move part);
    }
    i = i + 1;
  }
  return argv;
}

enum RunOutcome `public `clone `doc("What the runner determined one run of one gate amounted to, from what it observed. Five and closed, because the set is the contract's and the states that matter most are ones the gate cannot report: it is not alive in them. The distinctions are the ones a caller acts on differently. `Died` is a condition of the host and a retry is the correct response; `BrokeContract` is a defect in the gate's own code and `CouldNotStart` a defect in what the manifest declared or what the arena delivered, so both recur on every retry forever — a retry loop pointed at either reads as a flaky host for as long as anyone lets it run, and a caller that cannot tell them apart attributes the failure to the wrong repository.") {
  Measured,
  TimedOut,
  CouldNotStart,
  Died,
  BrokeContract,

  to_string(this) string `public `doc("How the contract spells this outcome. A rendering rather than a wire spelling, and there is deliberately no parse beside it: a run outcome is the runner's account of what it watched and crosses no wire, so nothing reads one back and there is no second spelling for a reader to agree with. It is also how two outcomes are compared, an enum satisfying neither Hashable nor Equal (promise-language/promise#40).") => match this {
    Measured => "measured",
    TimedOut => "timed out",
    CouldNotStart => "could not start",
    Died => "died",
    BrokeContract => "broke the contract",
  };
}

type GateRun `public `doc("What one execution of one gate produced, as the runner watched it happen. It reports rather than judges: the outcome the runner determined from what it observed, the envelope if the gate printed a readable one, and beside them the raw facts of how the process ended.") {
  string _gate `final;
  RunOutcome _outcome `final;
  int? _exit_code `final;
  string? _detail `final;
  GateOutput? _output `final;

  of(string move gate, RunOutcome move outcome, int? move exit_code, string? move detail, GateOutput? move output) Self `factory `public `doc("A finished run, as the runner watched it. The exit code is absent where the kernel never produced one — a gate that never started, one stopped at its deadline, and one stopped for printing more than the runner holds — because a number standing in for an absence would be the same false reading the outcome exists to replace. The detail explains a bad outcome and is absent when there is nothing to explain.") {
    return GateRun(_gate: move gate, _outcome: move outcome, _exit_code: move exit_code,
                   _detail: move detail, _output: move output);
  }

  get gate string `public `doc("The gate's declared name.") => this._gate;

  get outcome RunOutcome `public `doc("What the run amounted to, as the runner determined it from what it watched. This is what a caller reads; the exit code beside it is a diagnostic, and whether the numbers are acceptable is verify's question rather than this one's.") => this._outcome;

  get exit_code int? `public `doc("The gate process's exit code as the kernel reported it, kept for diagnosis, and absent where there was never one to keep — a gate that never started, one stopped at its deadline, or one stopped for printing more than the runner holds. Neither an outcome nor a verdict, and not what a caller reads to learn either: a gate killed mid-run never chose a code, and one that exits 0 having printed nothing has stated something false. What the run amounted to is the runner's account of it, and what the numbers amounted to is verify's.") => this._exit_code;

  detail(this) string? `public `doc("What explained a bad outcome — the host the gate declared no command for, the deadline it overran, what was wrong with what it printed, the tracked files it left changed — absent when there was nothing to explain. Prose for a human diagnosing the gate, and never something to match on: the outcome beside it is what a caller dispatches on. Allocates.") {
    if this._detail is present {
      return this._detail!.clone();
    }
    return none;
  }

  output(this) GateOutput? `public `doc("The envelope the gate printed, absent when it printed nothing readable. Allocates.") {
    if this._output is present {
      return this._output!.clone();
    }
    return none;
  }
}

run_gate!(GateSpec spec, HostOs host, string? move working_directory) GateRun `public `doc("Runs one gate on this host and reports what became of it. Dispatches the command for the host OS, execs it without a shell, collects stdout, and decodes the envelope if there is one. Eligibility is the caller's to have checked; this runs what it is given. The gate's declared timeout is enforced from the spawn — it bounds the read and the wait alike, since either is where a hung gate leaves the runner — and a gate that reaches it is stopped and reports nothing, because a run that was cut short measured nothing. What is read is bounded as well as how long it is read for: a gate that prints past what the runner will hold is stopped where the read stops, and what that amounts to is the contract's to say. The tracked state of the subject is recorded before the spawn and compared after, and a gate that left it changed is reported as having broken the contract with no measurements at all, whatever it printed and whatever else became of it — a repairing gate prints good numbers, and `measured` is the outcome a baseline ratchets on. What the run amounted to comes back as the outcome on the GateRun rather than as a raised error: a gate that never started, one stopped for running too long, one that died without printing a readable envelope and one that printed something that is not an envelope are four facts with three different owners, and an error type carrying them in prose is a set nobody can dispatch on without matching text. A gate that ran and reported a failure is a successful run of a failing gate, which is a different thing again. Raises only where the runner itself could not do its job, which includes a subject it cannot see.") {
  OsCommand command = spec.command();
  string line = command.for_os(host);
  if line.is_empty {
    string undeclared = spec.name;
    string no_line = "gate '" + spec.name + "' declares no command for " + host.to_string();
    return GateRun.of(move undeclared, RunOutcome.CouldNotStart, none, move no_line, none);
  }
  string[] argv = _argv(line);
  if argv.len == 0 {
    string blank = spec.name;
    string empty_line = "gate '" + spec.name + "' declares an empty command line";
    return GateRun.of(move blank, RunOutcome.CouldNotStart, none, move empty_line, none);
  }

  string program = argv[0];
  string[] args = string[]();
  int i = 1;
  while i < argv.len {
    string one = argv[i];
    args.push(move one);
    i = i + 1;
  }

  // Both returns above are settled before a process exists, so they are above
  // the recording too: there is nothing to compare a tree against when nothing
  // ran, and nothing to be gained from reading it twice.
  //
  // The directory is resolved once, here, and handed on rather than left
  // absent. The subject is the tree the gate runs in, so the directory that is
  // recorded and the directory the gate is spawned in have to be one value
  // rather than two that agree by accident — and an absent working directory
  // means the runner's own, which is a thing with a name.
  string directory = "";
  if given := working_directory {
    directory = given;
  } else {
    directory = os.working_dir?^;
  }

  Subject before = Subject.recorded(directory)?^;
  GateRun ran = _watch(spec, program, move args, directory)?^;
  Subject after = Subject.recorded(directory)?^;
  if difference := after.changed_from(before) {
    // Over every other outcome, not only over `measured`. A gate that rewrote
    // its subject is a defect in the gate's own code and recurs on every retry,
    // which is what separates `broke the contract` from the `maybe` of a
    // timeout and the `yes` of a death — and it is the one outcome that tells a
    // caller holding the rest of a transition's gates that this worktree is
    // spent (docs/gate-contract.md, "When a gate breaks the contract"). What it
    // costs is the detail the run would otherwise have carried; the
    // modification is the defect to fix first.
    string modified = spec.name;
    string why_modified = _modified(spec.name, difference);
    return GateRun.of(move modified, RunOutcome.BrokeContract, ran.exit_code, move why_modified, none);
  }
  return ran;
}

_watch!(GateSpec spec, string program, string[] move args, string directory) GateRun `doc("Spawns one gate, watches it, and reports what it did — everything a run amounts to except whether it left its subject alone, which is the caller's because the caller is what holds the reading taken before the spawn. Split out for that one reason: the outcomes below leave by eight different returns, and a comparison written at each of them would be eight copies of one rule with eight chances to be missed.") {
  // new_process_group is true: the deadline below has to reach the gate's work,
  // and a gate's work is its process tree. Killing the leader alone leaves its
  // children running and holding the stdout pipe this runner is reading, which
  // is the wait the deadline exists to end. A process group exists to be
  // signalled as a unit — signal_group requires one — and _stop signals one.
  os.Process child = os.Process.spawn(program, args, none, directory.clone(), new_process_group: true) ? e {
    // The one outcome settled before a process exists: exec refuses a program
    // that is absent or not executable, so there is no output to read and no
    // exit code to have. Not `died` — a retry reproduces a missing program
    // exactly, forever — and not the gate's defect either, since the exec line
    // naming it came from the manifest.
    string absent = spec.name;
    string never_ran = "gate '" + spec.name + "' could not start: " + e.message;
    return GateRun.of(move absent, RunOutcome.CouldNotStart, none, move never_ran, none);
  };
  // The clock starts at the spawn. The timeout bounds the gate's work and never
  // the wait for a turn to run, so nothing above this line is on it.
  Instant deadline = Instant.now() + spec.timeout;
  os.ProcessOutput out = child.take_stdout()?^;

  (printed, unreadable, too_much) := _drain_within(move out, deadline);
  if reason := unreadable {
    _stop(child);
    string unread = spec.name;
    string why_unread = "gate '" + spec.name + "' printed output that could not be read: " + reason;
    return GateRun.of(move unread, RunOutcome.Died, none, move why_unread, none);
  }
  if began := too_much {
    // Stopping the gate belongs to having stopped reading rather than to a
    // tidy-up after it (docs/gate-contract.md, "The envelope"). The read end is
    // already closed — the drain's goroutine returned, and the pipe went with
    // it — and this is the other half of that one act.
    _stop(child);
    string talkative = spec.name;
    string why_talkative = "gate '" + spec.name + "' printed more than " + _stdout_cap.to_string()
                           + " bytes on stdout, which is not an envelope; it began: " + began;
    return GateRun.of(move talkative, RunOutcome.BrokeContract, none, move why_talkative, none);
  }
  string text = "";
  if drained := printed {
    text = drained;
  } else {
    // Nothing in time, so the gate is still holding its stdout open and the
    // drain is still on it. Stopping the gate is what ends both.
    _stop(child);
    string stopped = spec.name;
    string why_stopped = _overran(spec.name, spec.timeout);
    return GateRun.of(move stopped, RunOutcome.TimedOut, none, move why_stopped, none);
  }

  int? code = _exit_within(child, deadline)?^;
  if reported := code {
    string name = spec.name;
    GateOutput? envelope = _envelope(name, move text) ? e {
      // A decode that failed and a validate that refused are one fact about the
      // gate: it printed something that is not an envelope. Which of the two it
      // was is in the detail, because it is not a distinction a caller acts on
      // differently — both are defects in the gate's own code and both recur.
      string broke = spec.name;
      string why_broke = e.message.clone();
      return GateRun.of(move broke, RunOutcome.BrokeContract, reported, move why_broke, none);
    };
    if envelope is present {
      return GateRun.of(move name, RunOutcome.Measured, reported, none, move envelope);
    }
    // The gate ended having printed nothing, so nothing was measured. The exit
    // code sitting beside that silence is exactly the number a caller must not
    // read as a result: a gate that exits 0 having measured nothing has stated
    // something false.
    string silent = spec.name;
    string why_silent = "gate '" + spec.name + "' exited without printing an envelope";
    return GateRun.of(move silent, RunOutcome.Died, reported, move why_silent, none);
  }
  // The gate closed its stdout and then kept running, which is the other place
  // the deadline can land. It ends the same way the drain's does.
  _stop(child);
  string late = spec.name;
  string why_late = _overran(spec.name, spec.timeout);
  return GateRun.of(move late, RunOutcome.TimedOut, none, move why_late, none);
}

_envelope!(string gate, string move printed) GateOutput? `doc("Reads what the gate printed, if it printed anything. Silence is absent rather than an error: a gate may die before it can measure, and how the process ended is the runner's to report rather than this decode's to guess.") {
  if printed.is_empty {
    return none;
  }
  GateOutput read = json.decode_string[GateOutput](move printed) ? e {
    raise RunError(message: "gate '" + gate + "' printed output that is not an envelope: " + e.message);
  };
  read.validate()?^;
  return read;
}

_drain_within(os.ProcessOutput move out, Instant deadline)(string?, string?, string?) `doc("Reads a gate's stdout to the end, giving up at the deadline. Reports what the gate printed, or why it could not be read, or what a gate that printed past the runner's bound began with, or none of the three — which is the deadline, and the caller's cue that the gate is still holding the pipe open. The read runs on a goroutine because a read on a pipe cannot be interrupted: bounding it means being somewhere else when it does not return. The pipe goes with the goroutine, so a drain that is abandoned still owns everything it holds. Stopping the gate is the caller's in every one of these: this reads, and what becomes of the gate is what the caller does about what it read.") {
  // Capacity 1 on each: a drain nobody is listening to any more must still be
  // able to hand over what it read and exit. An unbuffered send would park it
  // forever on a receiver that is not coming back.
  channel[string] read = channel[string](capacity: 1);
  channel[string] unreadable = channel[string](capacity: 1);
  channel[string] too_much = channel[string](capacity: 1);
  go _read_into(move out, read, unreadable, too_much);

  string? text = none;
  string? failure = none;
  string? began = none;
  while true {
    select {
      t := <-read:
        text = t;
      m := <-unreadable:
        failure = m;
      p := <-too_much:
        began = p;
      default:
    }
    if (text is present) || (failure is present) || (began is present) || Instant.now() >= deadline {
      break;
    }
    sleep(_poll_interval);
  }
  return (text, failure, began);
}

_read_into(os.ProcessOutput move pipe, channel[string] read, channel[string] unreadable, channel[string] too_much) `doc("Drains one gate's stdout and reports it, reports why it could not be read, or reports that the gate printed more than the runner holds and what it began with. This is the body _drain_within abandons when the deadline lands first, which is why it owns the pipe rather than borrowing one that would outlive its owner — and why returning here is what closes the read end, which is half of stopping a gate that printed too much and the reason this reports the cap rather than reading on to EOF.") {
  (printed, capped) := _read_all(pipe, _stdout_cap) ? e {
    unreadable.send(e.message.clone());
    return;
  };
  if capped {
    // The rest stops being worth holding here rather than at the caller: what
    // survives a gate that printed too much is a prefix, and everything past it
    // is carried no further than the line that cuts it off.
    too_much.send(_head(printed));
    return;
  }
  read.send(move printed);
}

_head(string text) string `doc("The prefix of what a gate printed that the runner keeps to say what it was printing. The head and not the tail, which is the one thing about it this file decides: what a reader needs is where the condition started, and a cap that keeps the most recent bytes discards exactly that (docs/org/engineering-guide.md, \"Everything a program writes has a ceiling\"). Shorter text is kept whole rather than padded: this is a bound, not a width.") {
  if text.len <= _kept_prefix {
    return text.clone();
  }
  return text[0:_kept_prefix];
}

_exit_within!(os.Process ~child, Instant deadline) int? `doc("Waits for a gate to exit, giving up at the deadline. Reports the exit code, or nothing when the deadline came first and the gate is still running. Unlike the drain this keeps the child rather than handing it to a goroutine: os.Process.wait blocks without bound, so the exit is noticed by asking whether the process is still alive and the wait is made only once the answer is no — at which point it collects a status rather than waiting for one. What that buys is the caller still holding the child when the deadline lands, and holding it is the whole of what stopping a gate takes: SIGKILL is reachable only through the Process that spawned it, so a wait that had taken the child could ask the gate to stop and never make it.") {
  while child.is_alive {
    if Instant.now() >= deadline {
      return none;
    }
    sleep(_poll_interval);
  }
  return child.wait()?^;
}

_stop(os.Process ~child) `doc("Ends a gate that has run out of time, and reaps it. The group is asked to stop first: the gate's children inherited its stdout, so a drain waiting on that pipe outlives the gate itself unless they go with it. Asked rather than told, because os.Signal carries no SIGKILL and so nothing can force a group (promise-language/promise#86). Then the gate itself is killed outright, because a deadline is not a request, and that one signal cannot be declined — which is what makes the wait after it bounded where a wait on a live gate is not. A signal that fails is swallowed: a gate that has already died is not a failure to stop it.") {
  child.signal_group(os.Signal.Terminate)? {
  };
  child.kill()? {
  };
  child.wait()? {
  };
}

get _poll_interval Duration `doc("How often the runner looks again at a gate it is already waiting on. Not the gate's deadline, which the manifest declares — this is the granularity at which a deadline is noticed, and the cost of noticing it. os.Process offers neither a wait with a deadline nor an interruptible read (promise-language/promise#86), so bounding either is a matter of looking again: short enough that a gate that has finished is not visibly held up, long enough that a gate running for half an hour is not a million wakeups. Delete the loops this paces when a deadline can be waited on directly.") {
  return Duration.from_millis(5);
}

get _stdout_cap int `doc("The bound the contract puts on a gate's stdout (docs/gate-contract.md, \"The envelope\"), in bytes: one MiB, and what it means and why it is that number are stated there. It is named at one boundary rather than written at the read that enforces it, the way a timeout is, so that the number the runner holds to can be found, cited and reached by a test without reading the loop.") {
  return 1048576;
}

get _kept_prefix int `doc("How much of an over-talkative gate's stdout survives into what the runner reports, in bytes. That a bounded prefix survives at all is the contract's (docs/gate-contract.md, \"The envelope\"); the size is this runner's, and it is chosen to sit well inside the bound one log line is held to (docs/org/logging.md, \"The line\") — a diagnostic that has to be cut again by whatever records it was not a bound, only a smaller unbounded one.") {
  return 1024;
}

_overran(string gate, Duration timeout) string `doc("What the runner says about a gate it stopped for running too long. One spelling, because the read and the wait are two places a deadline can land and one fact about the gate: it overran, and it was stopped. What it does not say is how, because that is the runner's business rather than the reader's — a reader acts on the deadline, not on the signal that enforced it.") {
  return "gate '" + gate + "' exceeded its declared timeout of " + timeout.to_string();
}

_modified(string gate, string difference) string `doc("What the runner says about a gate that did not give its subject back as it found it. The difference is subject.pr's — which paths moved, and whether anything was committed — and this is the runner's sentence around it, so the phrasing a reader meets has one spelling however the tree came to differ.") {
  return "gate '" + gate + "' modified the tracked tree it measured: " + difference;
}

_read_all!(os.ProcessOutput ~pipe, int cap)(string, bool) `doc("Drains a pipe to a string, stopping once the gate has printed more than the cap allows the runner to hold. Reports what it read and whether the cap is what stopped it, rather than EOF. A gate's envelope is one JSON object and is read whole rather than streamed, so the cap is on the whole of it. One byte past the cap is read deliberately: a gate that printed exactly the cap printed something that can still be an envelope, and the byte after it is the only thing that tells the two apart. The cap arrives as a parameter rather than being read here, so that the one boundary it is declared at stays the one place it is decided — and so a test can reach this bound at a size a test can print.") {
  Builder collected = Builder();
  u8[] buf = u8[]();
  int i = 0;
  while i < 4096 {
    buf.push(0u8);
    i = i + 1;
  }
  while true {
    int n = pipe.read(buf)?^;
    if n <= 0 {
      break;
    }
    // What is left of the cap, plus the byte that proves it was passed. The
    // builder's own length is the count: a second counter beside it would be
    // one more thing to keep in step with the bytes actually held.
    int room = (cap + 1) - collected.len;
    int take = n;
    if take > room {
      take = room;
    }
    u8[] chunk = u8[]();
    int j = 0;
    while j < take {
      chunk.push(buf[j]);
      j = j + 1;
    }
    collected.write_string(string.from_bytes(chunk));
    if collected.len > cap {
      return (collected.to_string(), true);
    }
  }
  return (collected.to_string(), false);
}
