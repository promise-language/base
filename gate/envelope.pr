// The gate output envelope: what one gate run reports to Reactor.
//
// **The contract this implements is [docs/gate-contract.md](../docs/gate-contract.md)**,
// and that document is where it is stated: a gate reports measurements and never
// a verdict, completeness is the absence of a reason rather than a flag beside
// one, there is no marker for an envelope being whole, a member's outcome is a
// fact about one named thing, and a measurement carries the type it was measured
// in. Restating any of that here would be a second copy to keep in sync, and the
// contract is language-neutral while this file is one language's implementation
// of it.
//
// What is here and not there: this module's encoding is derived from the
// declared shape rather than written, which is how the type comes to travel with
// the value with no encoder for anyone to maintain. `Outcome.encode` is the one
// departure, and it and each platform defect worked around here are argued at
// the declaration they sit on.

type GateError is error `public `doc("A gate envelope that cannot be accepted.") {
}

enum MetricValue `public `serializable `clone `doc("One measurement. Integers stay integers: a test count encoded as a float is a count nobody can compare exactly. The measured type is written beside the value rather than left to the reader, because a bare 5 is an int and a float alike and JSON cannot tell them apart — so the envelope round-trips, and a value that disagrees with what the manifest declared is a mismatch a reader can name instead of a widening it cannot see.") {
  Int(int value),
  Float(f64 value),

  to_string(this) string `public `doc("The measurement as text, in its own type.") => match this {
    Int(v) => v.to_string(),
    Float(v) => v.to_string(),
  };
}

enum Outcome `public `clone `doc("How one named thing inside a group turned out. Closed for the reason a manifest's vocabularies are: a `skipped` written where `excluded` was meant does not error, it misses a lookup and is counted as something else. Seven rather than two, because a reader acts on the distinctions differently — `excluded` is a deliberate \"not for this target\" and is not a failure, and `not-run` says the suite never reached it, which is a different fact about the subject from failing.") {
  Pass,
  Fail,
  Timeout,
  Leak,
  Memory,
  Excluded,
  NotRun,

  encode!(Encoder ~e) `public `doc("Writes the wire spelling. Written rather than derived, which is the one place this envelope departs from its own rule: a derived enum writes its variant's Promise name, and `NotRun` is not a spelling a gate written in another language would guess at — the envelope is the surface this contract is satisfied by printing JSON to.") {
    e.encode_string(this.to_string())?^;
  }

  decode!(Decoder ~d) Outcome `factory `public `doc("Reads the wire spelling, and refuses one outside the set here rather than at a lookup that quietly misses. The envelope is decoded before it is validated, so this is the boundary an unknown outcome meets.") {
    string name = d.decode_string()?^;
    if name == "pass" { return Outcome.Pass; }
    if name == "fail" { return Outcome.Fail; }
    if name == "timeout" { return Outcome.Timeout; }
    if name == "leak" { return Outcome.Leak; }
    if name == "memory" { return Outcome.Memory; }
    if name == "excluded" { return Outcome.Excluded; }
    if name == "not-run" { return Outcome.NotRun; }
    raise DecodeError(field: "outcome", position: none,
                      message: "unknown outcome '" + name + "': expected pass, fail, timeout, leak, memory, excluded, or not-run");
  }

  to_string(this) string `public `doc("The wire spelling — what encode writes and decode reads back.") => match this {
    Pass => "pass",
    Fail => "fail",
    Timeout => "timeout",
    Leak => "leak",
    Memory => "memory",
    Excluded => "excluded",
    NotRun => "not-run",
  };
}

type GroupMember `public `serializable `clone `doc("One named thing inside a group, and how it turned out. A group says which file regressed; a member says which test, and what it said when it did — the same argument one level further down, and the one a reader who knows a file got worse would otherwise re-run the suite to answer.") {
  string _name `final `key("name");
  Outcome? _outcome `final `key("outcome");
  string? _detail `final `key("detail");
  f64? _elapsed `final `key("elapsed");

  of(string move name, Outcome move outcome, string? move detail, f64? move elapsed) Self `factory `public `doc("Builds one member. The detail explains a bad outcome and is absent when there is nothing to explain; the elapsed is absent when the subject did not time it.") {
    return GroupMember(_name: move name, _outcome: move outcome, _detail: move detail, _elapsed: move elapsed);
  }

  get name string `public `doc("The thing, as the subject names it.") => this._name;

  get outcome Outcome? `public `doc("How it turned out. A fact about this named thing and never a verdict about the run: what the measurements amount to is decided outside the gate, against terms the gate does not hold. Optional on the way in, and never absent in an envelope that passed `validate`: a member arriving from another language may omit the key, and this type has to be able to hold what that gate printed in order to say what is wrong with it. Every other required field on this wire does that by arriving as its empty value; an enum has none, and a derived decode handed a missing one unwraps a none and takes the reading process down instead of refusing the envelope (promise-language/base#39).") => this._outcome;

  detail(this) string? `public `doc("What explained a bad outcome — a panic, an assertion message — absent when nothing did. Bounded: the assertion and where it was, not the transcript around it, which is what stderr already carries. Allocates.") {
    if this._detail is present {
      return this._detail!.clone();
    }
    return none;
  }

  elapsed(this) f64? `public `doc("How long this one thing took, in seconds, absent when the subject did not time it. This is what the metrics map cannot give: a per-part total says a suite got slower, and a per-member duration says which one did.") {
    if this._elapsed is present {
      return this._elapsed!;
    }
    return none;
  }
}

type MetricGroup `public `serializable `clone `doc("Measurements for one part of a run — a package, a file, a suite. A total says a ratchet moved; a group says where, which is the difference between a bisect and a glance. Its members say which named things inside it turned out how.") {
  string _name `final `key("name");
  map[string, MetricValue] _metrics `final `key("metrics");
  GroupMember[] _members `final `key("members");

  of(string move name, map[string, MetricValue] move metrics) Self `factory `public `doc("Builds a named group of measurements. Members are added afterwards, because a group need not have any: not every part of a run has named things inside it, and a gate reporting only per-part totals has reported what it measured.") {
    return MetricGroup(_name: move name, _metrics: move metrics, _members: GroupMember[]());
  }

  get name string `public `doc("What this group measures.") => this._name;

  get metrics map[string, MetricValue] `public `doc("The measurements, keyed by the names the manifest declared.") => this._metrics.clone();

  members(this) GroupMember[] `public `doc("The named things inside this group, empty when the gate reports only its per-part totals. Allocates.") => this._members.clone();

  with_member(~this, GroupMember move member) `public `doc("Adds one named thing and how it turned out.") {
    this._members.push(move member);
  }
}

_validate_member!(string group, GroupMember member) `doc("Raises on a member that cannot mean what it says. Every message names the group and the member, because an envelope refused without saying which entry did it sends a reader back through the whole run.") {
  if member.name.is_empty {
    raise GateError(message: "a member of group '" + group + "' has no name, so it names nothing");
  }
  if !(member.outcome is present) {
    raise GateError(message: "member '" + member.name + "' of group '" + group + "' reports no outcome, which is what a member is for");
  }
  string? detail = member.detail();
  if detail is present {
    if detail.is_empty {
      raise GateError(message: "member '" + member.name + "' of group '" + group + "' carries an empty detail, which explains nothing");
    }
  }
  f64? elapsed = member.elapsed();
  if elapsed is present {
    if elapsed < 0.0 {
      raise GateError(message: "member '" + member.name + "' of group '" + group + "' took a negative time");
    }
  }
}

type GateOutput `public `serializable `clone `doc("One gate run's result. Written as a single JSON object on stdout; human-readable progress belongs on stderr, which Reactor never parses.") {
  int _schema_version `final `key("schema_version");
  string _target `final `key("target");
  map[string, MetricValue] _metrics `final `key("metrics");
  MetricGroup[] _groups `final `key("groups");
  string? _incomplete_reason `final `key("incomplete_reason");

  of(string move target, map[string, MetricValue] move metrics) Self `factory `public `doc("A run that measured everything it normally measures, for one target. One gate run reports one target — that is invariant, not a convenience.") {
    return GateOutput(_schema_version: 1, _target: move target, _metrics: move metrics,
                      _groups: MetricGroup[](), _incomplete_reason: none);
  }

  partial!(string move target, map[string, MetricValue] move metrics, string move reason) Self `factory `public `doc("A run that could not measure everything — a suite skipped for a missing tool, a subset deliberately selected. The reason is carried because a human decides what to do about it, and an empty one is refused: completeness is this reason's absence, so a run that is incomplete with nothing to say is the one state this envelope has no way to mean.") {
    if reason.is_empty {
      raise GateError(message: "an incomplete run must say why it measured less than usual");
    }
    return GateOutput(_schema_version: 1, _target: move target, _metrics: move metrics,
                      _groups: MetricGroup[](), _incomplete_reason: move reason);
  }

  get schema_version int `public `doc("Wire version. Reactor refuses unknown majors.") => this._schema_version;

  get target string `public `doc("Which declared target this run's verdict speaks for.") => this._target;

  get complete bool `public `doc("Whether these measurements cover everything this gate normally measures. A run that skipped a suite reports honest numbers that understate the tree, which is indistinguishable from a regression unless the gate says so. **Reactor must not move a baseline from an incomplete run** — ratcheting on one would lower the floor for a reason that is not about the code. Derived: a run is complete exactly when it carries no reason not to be, so it cannot claim both.") => !(this._incomplete_reason is present);

  validate!(this) `public `doc("Raises on an envelope that cannot mean what it says. The factories enforce this on anything built in Promise; **an envelope that arrived over the wire has been through none of them**, because a derived decode constructs the type field by field rather than through a factory (promise-language/promise#45). So a consumer runs this after decoding, and a gate written in another language is held to the same rule as one written here.") {
    if this._target.is_empty {
      raise GateError(message: "an envelope names no target, so its verdict speaks for nothing");
    }
    if this._incomplete_reason is present {
      if this._incomplete_reason!.is_empty {
        raise GateError(message: "an incomplete run must say why it measured less than usual");
      }
    }
    int i = 0;
    while i < this._groups.len {
      // Bound once rather than indexed repeatedly: a method call on an array
      // index leaks the element copy (promise-language/promise#57).
      MetricGroup group = this._groups[i];
      string group_name = group.name;
      GroupMember[] members = group.members();
      int j = 0;
      while j < members.len {
        GroupMember member = members[j];
        _validate_member(group_name, member)?^;
        j = j + 1;
      }
      i = i + 1;
    }
  }

  incomplete_reason(this) string? `public `doc("Why the run measured less than usual, absent when it did not. Carried in the envelope rather than left on stderr, which nothing parses. Allocates.") {
    if this._incomplete_reason is present {
      return this._incomplete_reason!.clone();
    }
    return none;
  }

  metrics(this) map[string, MetricValue] `public `doc("The measurements, keyed by the names the manifest declared. Allocates.") => this._metrics.clone();

  groups(this) MetricGroup[] `public `doc("Per-part measurements, empty when the gate reports only a total. Allocates.") => this._groups.clone();

  with_group(~this, MetricGroup move group) `public `doc("Adds one group of per-part measurements.") {
    this._groups.push(move group);
  }

}
