use io;

use os;

_spec(string move command) GateSpec {
  return _spec_lasting(move command, Duration.from_secs(60));
}

_spec_lasting(string move command, Duration timeout) GateSpec {
  VcsTransition[] b = VcsTransition[]();
  b.push(VcsTransition.Commit);
  return GateSpec.of("probe", OsCommand.of(move command), none, HostOs[](), none, HostArch[](),
                     timeout, move b, none, Exclusion[](), string[](), MetricSpec[]());
}

// One copy of the envelope these fixtures print. The body is shared because the
// two envelopes below differ in one key and nothing else: a second copy would be
// two things to edit when the wire changes, and the difference is the point.
get _envelope_body string => "\"schema_version\":1,\"target\":\"linux/amd64\",\"metrics\":\{\"test_count\":\{\"type\":\"Int\",\"value\":17703\}\},\"groups\":[]";

_an_envelope() string {
  return "\{" + _envelope_body + "\}";
}

_an_envelope_incomplete_with_no_reason() string {
  // Well-formed JSON that decodes and then fails validate: an incomplete run
  // with nothing to say is the one state an envelope cannot mean.
  return "\{" + _envelope_body + ",\"incomplete_reason\":\"\"\}";
}

_printing_an_envelope(Duration timeout) GateSpec {
  return _spec_lasting("/bin/echo " + _an_envelope(), timeout);
}

get _closes_stdout string => "gate-closes-stdout.sh";

get _prints_and_fails string => "gate-prints-and-fails.sh";

_a_gate_that_measures_and_fails() string {
  // A gate that prints its envelope and then exits non-zero. No stock program
  // does both — /bin/echo always succeeds — so this is a script the exec line
  // names, which is the contract's own answer for a gate needing shell features
  // (docs/gate-contract.md, "The exec line"). Single quotes because the envelope
  // carries none of its own.
  string dir = os.temp_dir;
  io.File.write_content(dir + "/" + _prints_and_fails, "echo '" + _an_envelope() + "'\nexit 1\n")?!;
  return dir;
}

get _measures_then_overruns string => "gate-measures-then-overruns.sh";

_a_gate_that_measures_and_then_overruns() string {
  // A gate that prints a whole envelope, closes its stdout so the drain is
  // satisfied by it, and then keeps running until it is stopped. The one shape
  // that reaches the deadline with a readable envelope already in the runner's
  // hand, which is what makes discarding it a decision rather than an absence.
  string dir = os.temp_dir;
  io.File.write_content(dir + "/" + _measures_then_overruns,
                        "echo '" + _an_envelope() + "'\nexec 1>&-\nsleep 30\n")?!;
  return dir;
}

_a_gate_that_closes_its_stdout() string {
  // A gate that stops talking and keeps running is not a stock program, and the
  // exec line cannot spell one: it splits on whitespace and supports no quoting,
  // so a shell fragment cannot be written into it. The contract's own answer is
  // the one taken here — a gate needing shell features is a script the line
  // names (docs/gate-contract.md, "The exec line").
  //
  // It prints one line before closing, so a drain that returned early is
  // distinguishable from one that read everything the gate had to say.
  //
  // The directory is returned rather than the path because it is what run_gate
  // is handed: a working directory reaches the child whole, while a temp path
  // written into an exec line would be split on any space it happened to carry.
  string dir = os.temp_dir;
  io.File.write_content(dir + "/" + _closes_stdout, "echo ready\nexec 1>&-\nsleep 30\n")?!;
  return dir;
}

an_exec_line_splits_into_program_and_arguments() `test {
  string[] argv = _argv("bin/gate test --wasm");
  assert(argv.len == 3, msg: "program plus two arguments");
  assert(argv[0] == "bin/gate", msg: "the program is the first token");
  assert(argv[2] == "--wasm", msg: "and flags are arguments, not shell syntax");

  string[] padded = _argv("  bin/gate   test  ");
  assert(padded.len == 2, msg: "runs of whitespace collapse rather than making empty arguments");
}

a_run_reports_which_gate_it_was() `test {
  GateSpec g = _spec("/usr/bin/true ignored args");
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.gate == "probe", msg: "the run names its gate");
  int? code = r.exit_code;
  assert(code is present, msg: "a gate that ran has the code the kernel gave it");
  assert(code! == 0, msg: "and arguments reached exec without a shell in between");
}

a_gate_that_prints_an_envelope_is_read() `test {
  GateSpec g = _printing_an_envelope(Duration.from_secs(60));
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "measured", msg: "a gate that completed and printed a valid envelope measured");
  GateOutput? printed = r.output();
  assert(printed is present, msg: "the envelope came back");
  if printed is present {
    assert(printed.target == "linux/amd64", msg: "with the target it spoke for");
    assert(printed.complete, msg: "and its completeness derived from the absent reason");
  }
  string? why = r.detail();
  assert(!(why is present), msg: "and a run with nothing wrong with it explains nothing");
}

a_gate_that_exits_clean_having_printed_nothing_died() `test {
  // A gate may die before it can measure. A missing envelope is absence rather
  // than a malformed one, and what killed it is the runner's to report — so the
  // run is `died` and a retry is the correct response. The exit code sitting
  // beside that silence is the reason the outcome cannot be the code: zero here
  // is a gate stating something false, and a caller reading it believes it.
  GateSpec g = _spec("/usr/bin/true");
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "silence is absent rather than unreadable");
  assert(r.outcome.to_string() == "died", msg: "and a gate that printed no envelope measured nothing");
  int? code = r.exit_code;
  assert(code is present, msg: "the process's own code is recorded as the kernel gave it");
  assert(code! == 0, msg: "and it is the zero that must not be read as a result");
  string? why = r.detail();
  assert(why is present, msg: "and the run says why it amounted to nothing");
  if why is present {
    // The pairing this outcome exists for: an exit code of zero and a run that
    // measured nothing. The detail is the only thing standing between a reader
    // and that zero, so a `died` that explained nothing here would be read back
    // as the success the gate falsely claimed.
    assert(why.contains("without printing an envelope"), msg: "and what the silence amounted to: " + why);
  }
}

a_failing_gate_is_a_successful_run() `test {
  // Running a gate that reports failure is not a failure to run it: the gate
  // printed a valid envelope, so the run measured, and whether 17703 is
  // acceptable is verify's question rather than this one's. The exit code is
  // 1 and does not change that, which is the contract's "the gate's own exit
  // code is not consulted" with something to consult.
  string dir = _a_gate_that_measures_and_fails();
  GateSpec g = _spec("/bin/sh " + _prints_and_fails);
  GateRun r = run_gate(g, HostOs.Linux, move dir)?!;
  assert(r.outcome.to_string() == "measured", msg: "a gate that printed a valid envelope measured");
  int? code = r.exit_code;
  assert(code is present, msg: "the process's own code is recorded");
  assert(code! == 1, msg: "and it is not zero, and is not what the run amounted to");
  GateOutput? printed = r.output();
  assert(printed is present, msg: "the measurements a failing gate made are still measurements");
}

output_that_is_not_an_envelope_breaks_the_contract() `test {
  GateSpec g = _spec("/bin/echo not-json-at-all");
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "broke the contract",
         msg: "a gate printing something else is a contract breach, not a verdict");
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "and a violation yields no measurements at all");
  int? code = r.exit_code;
  assert(code is present, msg: "the process ran, so the kernel's number is kept for diagnosis");
  string? why = r.detail();
  assert(why is present, msg: "and what was wrong with what it printed is said, once, for a human");
  if why is present {
    assert(why.contains("not an envelope"),
           msg: "naming the half of the breach this was, which the outcome does not: " + why);
  }
}

an_envelope_that_fails_validation_breaks_the_contract() `test {
  // The other half of the breach. The gate printed JSON that decodes as an
  // envelope and is then refused by validate, which arrives as a GateError
  // rather than the RunError a failed decode raises — two error types, one
  // fact about the gate, and a caller that had to tell them apart would be
  // matching on text again.
  GateSpec g = _spec("/bin/echo " + _an_envelope_incomplete_with_no_reason());
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "broke the contract",
         msg: "an envelope that cannot mean what it says is a breach, not a measurement");
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "and nothing it carried is reported");
  // Which of the two breaches it was is the detail's whole job here, since the
  // outcome deliberately does not distinguish them. A detail that said only
  // "broke the contract" would satisfy every other assertion in both tests and
  // leave a human with a gate to diagnose and nothing to diagnose it from.
  string? why = r.detail();
  assert(why is present, msg: "the run says what was wrong with what the gate printed");
  if why is present {
    assert(why.contains("must say why it measured less than usual"),
           msg: "carrying what validate refused it for, rather than a decode's complaint: " + why);
  }
}

a_gate_that_never_ends_is_killed_at_its_timeout() `test {
  // /bin/cat blocks on a stdin nobody writes to: it prints nothing, holds its
  // stdout open and never exits, so the drain and the wait are both on it and
  // only the deadline ends either. A runner that did not enforce the timeout
  // would hang here rather than fail here.
  GateSpec g = _spec_lasting("/bin/cat", Duration.from_millis(200));
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "timed out", msg: "a gate that outlasts its timeout is stopped, not waited on");
  int? code = r.exit_code;
  assert(!(code is present), msg: "and a gate stopped at its deadline never chose an exit code to report");
  // The one place _overran's text is read. It is a diagnostic for a human, not
  // what a caller dispatches on — that is the outcome above — and this asserts
  // it names the gate and what happened to it rather than the signal used.
  string? why = r.detail();
  assert(why is present, msg: "the run says why it ended");
  if why is present {
    assert(why.contains("probe"), msg: "naming the gate: " + why);
    assert(why.contains("exceeded its declared timeout"), msg: "and that it overran: " + why);
  }
}

a_gate_that_would_finish_late_is_stopped_when_its_time_runs_out() `test {
  // Three seconds of work against a fifth of a second of budget. The clock is
  // the assertion that matters: a runner that let the gate finish would report
  // the very same error three seconds later, which is the defect, not the fix.
  GateSpec g = _spec_lasting("/bin/sleep 3", Duration.from_millis(200));
  Instant started = Instant.now();
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  Duration took = started.elapsed();
  assert(r.outcome.to_string() == "timed out", msg: "the gate was stopped for running too long");
  assert(took < Duration.from_secs(2), msg: "and stopped near its deadline rather than running to completion");
}

a_wait_that_outlasts_the_deadline_gives_up_on_the_gate() `test {
  // The deadline has to bound the wait as well as the read, and the case where
  // only the wait is left is a gate that has closed its stdout and not exited.
  // No stock program does that, so the wait is reached directly here — through
  // the same function a run reaches it through, not a second copy of it.
  string[] args = string[]();
  args.push("3".clone());
  os.Process child = os.Process.spawn("/bin/sleep", args, none, none, new_process_group: true)?!;
  Instant started = Instant.now();
  int? code = _exit_within(child, Instant.now() + Duration.from_millis(200))?!;
  Duration took = started.elapsed();
  assert(!(code is present), msg: "a wait that runs out of time reports no exit code");
  assert(took < Duration.from_secs(2), msg: "and gives up at its deadline rather than waiting the process out");
  // The child is still the caller's, which is the point of giving up this way
  // rather than handing it to a wait that cannot let go of it.
  _stop(child);
  assert(!child.is_alive, msg: "and leaves the gate where the runner can still stop it");
}

a_gate_that_closes_its_stdout_and_keeps_running_is_stopped_at_its_timeout() `test {
  // The wait half of the deadline reached through run_gate, rather than through
  // the helper run_gate calls. It is the only run shape that gets there: the
  // drain ends on EOF, so a gate that closes its stdout satisfies it while still
  // running, and everything left of the budget is spent on the wait. Without
  // this, run_gate could stop bounding its wait altogether — go back to a bare
  // child.wait() — and every other test here would still pass.
  string dir = _a_gate_that_closes_its_stdout();
  GateSpec g = _spec_lasting("/bin/sh " + _closes_stdout, Duration.from_millis(200));
  Instant started = Instant.now();
  GateRun r = run_gate(g, HostOs.Linux, move dir)?!;
  Duration took = started.elapsed();
  assert(r.outcome.to_string() == "timed out", msg: "a gate that stops talking and keeps running still overruns its budget");
  int? code = r.exit_code;
  assert(!(code is present), msg: "and having been stopped, it reports no exit code either");
  assert(took < Duration.from_secs(2), msg: "and is stopped at the deadline rather than waited out");
}

a_gate_that_printed_an_envelope_and_then_overran_measured_nothing() `test {
  // A run cut short measured nothing, whatever it printed before the clock ran
  // out — so the outcome is `timed out` and the envelope in hand is dropped.
  // Every other timeout test uses a gate that printed nothing an envelope could
  // be made of, so a runner that reported `measured` off the text it happened to
  // have drained, or carried that envelope out beside a `timed out`, would pass
  // all of them. The distinction is the contract's: whether the gate spoke is a
  // different question from whether the run finished, and only one of them is
  // what a caller is told here.
  string dir = _a_gate_that_measures_and_then_overruns();
  GateSpec g = _spec_lasting("/bin/sh " + _measures_then_overruns, Duration.from_millis(200));
  GateRun r = run_gate(g, HostOs.Linux, move dir)?!;
  assert(r.outcome.to_string() == "timed out",
         msg: "a gate stopped at its deadline timed out, whatever it had printed first");
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "and reports no measurements, because a run that was cut short measured nothing");
}

a_drain_ends_at_eof_rather_than_at_the_gate_s_exit() `test {
  // What makes two deadline sites necessary rather than one, and the premise the
  // test above rests on: the drain is satisfied by the last writer closing the
  // pipe, which a gate can do without ending. A runner that read stdout and
  // waited as one step would have nothing to bound separately, and this gate
  // would be indistinguishable from one that had finished.
  string dir = _a_gate_that_closes_its_stdout();
  string[] args = string[]();
  args.push(_closes_stdout);
  os.Process child = os.Process.spawn("/bin/sh", args, none, move dir, new_process_group: true)?!;
  os.ProcessOutput out = child.take_stdout()?!;
  (printed, unreadable, too_much) := _drain_within(move out, Instant.now() + Duration.from_secs(5));
  assert(printed is present, msg: "the drain ends when the gate closes its stdout");
  assert(printed!.trim() == "ready", msg: "having read everything the gate said, not having given up early");
  assert(!(unreadable is present), msg: "and an orderly close is not a read that failed");
  assert(!(too_much is present), msg: "nor a gate that printed more than the runner holds");
  assert(child.is_alive, msg: "and the gate that closed it is still running");
  _stop(child);
}

a_stop_takes_the_gate_s_descendants_with_it() `test {
  // A gate's work is its process tree, not its leader, and this gate exits at
  // once leaving a child behind holding the stdout the drain is on — which is
  // the hang the timeout exists to end. A stop that reached only the leader
  // would report a timeout and leave the work running. Which of _stop's two
  // signals gets there is deliberately not asserted: that is the runner's
  // business, and pinning it here would fix an implementation rather than a
  // behaviour.
  //
  // EOF is the signal, not a delay. The drain below returns as soon as the last
  // writer is gone, so its deadline bounds how long the failure takes to report
  // and nothing waits on it when the stop worked.
  string[] args = string[]();
  args.push("-c".clone());
  args.push("sleep 30 & exit".clone());
  os.Process child = os.Process.spawn("/bin/sh", args, none, none, new_process_group: true)?!;
  os.ProcessOutput out = child.take_stdout()?!;
  _stop(child);
  (printed, unreadable, too_much) := _drain_within(move out, Instant.now() + Duration.from_secs(5));
  assert(printed is present, msg: "a stopped gate's descendants are stopped with it, so its stdout reaches EOF");
  assert(!(unreadable is present), msg: "and the pipe closes rather than failing");
  assert(!(too_much is present), msg: "and a gate that said nothing said nothing past the bound");
}

// What an endless gate prints, one token per line. A word rather than a
// character, so a prefix that came back can be recognised as this gate's output
// and not as whatever else was on the pipe.
get _endless_token string => "talkative";

_a_gate_that_never_stops_printing() string[] {
  // /usr/bin/yes prints its argument forever and never closes its stdout, which
  // is the shape this bound exists for: a runner that reads to EOF reads until
  // it dies. It is a stock program, so no script is needed and nothing but the
  // runner decides when the printing stops.
  string[] args = string[]();
  args.push(_endless_token.clone());
  return args;
}

a_read_that_reaches_the_cap_stops_there() `test {
  // The read stops at the bound rather than draining what is there. Ten bytes
  // are on the pipe and four are allowed, so a read that came back with all of
  // them is the unbounded drain this replaced.
  string[] args = string[]();
  args.push("abcdefghij".clone());
  os.Process child = os.Process.spawn("/bin/echo", args, none, none, new_process_group: true)?!;
  os.ProcessOutput out = child.take_stdout()?!;
  (text, capped) := _read_all(out, 4)?!;
  assert(capped, msg: "a gate that printed past the cap is reported as having done so");
  assert(text.len == 5, msg: "and the read holds the cap and the one byte that proves it was passed");
  _stop(child);
}

a_read_that_exactly_fills_the_cap_is_not_capped() `test {
  // The inclusive boundary, and the reason the read goes one byte past the cap
  // rather than stopping on it: a gate that printed exactly what it is allowed
  // to printed an envelope, and an off-by-one here turns the largest legal
  // envelope there is into a contract breach nobody can explain.
  string[] args = string[]();
  args.push("abc".clone());
  os.Process child = os.Process.spawn("/bin/echo", args, none, none, new_process_group: true)?!;
  os.ProcessOutput out = child.take_stdout()?!;
  (text, capped) := _read_all(out, 4)?!;
  assert(!capped, msg: "a gate that printed exactly the cap has not printed past it");
  assert(text == "abc\n", msg: "and everything it said is read, to the last byte the cap allows");
  _stop(child);
}

a_drain_that_hits_the_cap_reports_what_the_gate_began_with() `test {
  // The drain's third answer, reached directly. A gate that never stops printing
  // never reaches EOF, so this is the one case where neither what it printed nor
  // a failed read is what comes back — and a runner without the bound sits here
  // until its deadline, or until its memory runs out, whichever is first.
  os.Process child = os.Process.spawn("/usr/bin/yes", _a_gate_that_never_stops_printing(), none,
                                      none, new_process_group: true)?!;
  os.ProcessOutput out = child.take_stdout()?!;
  (printed, unreadable, too_much) := _drain_within(move out, Instant.now() + Duration.from_secs(5));
  assert(!(printed is present), msg: "a gate that never stops printing never reaches the end of its output");
  assert(!(unreadable is present), msg: "and stopping at the bound is not a read that failed");
  assert(too_much is present, msg: "the drain reports a gate that printed more than the runner holds");
  if too_much is present {
    // Both halves of what survives: bounded, and still worth reading. A prefix
    // of nothing would satisfy the bound and tell a human nothing about which
    // gate to go and fix.
    assert(too_much.len == _kept_prefix, msg: "keeping a prefix of what was printed rather than the stream, and all of the prefix there is room for");
    assert(too_much.contains(_endless_token), msg: "and enough of it to say what the gate was printing");
  }
  // Stopping the gate is the runner's, not the drain's: the drain reads, and
  // what becomes of a gate that printed too much is decided where every other
  // outcome is decided.
  _stop(child);
  assert(!child.is_alive, msg: "and the gate is left where the runner can still stop it");
}

a_gate_that_never_stops_printing_breaks_the_contract() `test {
  // The whole of this bound, end to end. A gate that prints without end has not
  // printed one JSON object, so the run is a breach rather than a measurement —
  // and the clock is the other assertion: a runner that kept reading would
  // report the very same run five seconds later as a timeout, which is the
  // defect wearing the outcome of a different one.
  GateSpec g = _spec_lasting("/usr/bin/yes " + _endless_token, Duration.from_secs(5));
  Instant started = Instant.now();
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  Duration took = started.elapsed();
  assert(r.outcome.to_string() == "broke the contract",
         msg: "a gate that printed more than the runner holds printed no envelope");
  assert(took < Duration.from_secs(2), msg: "and the bound ended the read rather than the deadline ending the gate");
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "and a violation yields no measurements at all");
  int? code = r.exit_code;
  assert(!(code is present), msg: "the gate was stopped, so it never chose an exit code to report");
  string? why = r.detail();
  assert(why is present, msg: "the run says what the gate did");
  if why is present {
    assert(why.contains("probe"), msg: "naming the gate: " + why);
    assert(why.contains("printed more than"), msg: "and what it did rather than what was wrong with its JSON: " + why);
    assert(why.contains(_endless_token), msg: "and what it was printing instead of an envelope: " + why);
    // The half of this issue a correct outcome alone would not catch: the
    // megabyte the runner read must not travel out with the report.
    assert(why.len < _kept_prefix + 200, msg: "carrying a prefix rather than the stream: " + why.len.to_string() + " bytes");
  }
}

a_gate_that_has_already_finished_is_reported_past_its_deadline() `test {
  // The order the wait asks its two questions in. A gate that ended measured
  // whatever it measured, whether or not the clock ran out while it was ending,
  // so the exit is looked for before the deadline is. Stopping the gate first is
  // what makes "already finished" a fact here rather than a race on one.
  string[] args = string[]();
  os.Process child = os.Process.spawn("/bin/cat", args, none, none, new_process_group: true)?!;
  _stop(child);
  int? code = _exit_within(child, Instant.now() - Duration.from_secs(1))?!;
  assert(code is present, msg: "a gate that has already finished is reported rather than timed out");
}

a_wait_that_finishes_inside_the_deadline_reports_the_code() `test {
  // The same wait on a gate that ends in time: it must report the kernel's code
  // rather than the deadline's silence, and must not sit out the budget waiting
  // to be sure. /usr/bin/false is chosen over true so a code of zero cannot be
  // an uninitialised value passing for an answer.
  string[] args = string[]();
  os.Process child = os.Process.spawn("/usr/bin/false", args, none, none, new_process_group: true)?!;
  Instant started = Instant.now();
  int? code = _exit_within(child, Instant.now() + Duration.from_secs(30))?!;
  Duration took = started.elapsed();
  assert(code is present, msg: "a gate that exits in time reports an exit code");
  assert(code! == 1, msg: "and it is the code the kernel gave it");
  assert(took < Duration.from_secs(2), msg: "and the wait ends with the gate, not with the deadline");
}

a_stopped_gate_is_dead_and_reaped() `test {
  // What both deadline paths end at, asserted on its own: stopping is the thing
  // the timeout exists to do, and a run that reported a timeout while leaving
  // the gate running would satisfy every other test here. /bin/cat never exits
  // on its own, so its death is the stop's doing and nothing else's.
  string[] args = string[]();
  os.Process child = os.Process.spawn("/bin/cat", args, none, none, new_process_group: true)?!;
  assert(child.is_alive, msg: "the gate is running before it is stopped");
  _stop(child);
  assert(!child.is_alive, msg: "a stopped gate is not still running");
}

a_gate_that_finishes_inside_its_timeout_is_left_alone() `test {
  // The other side of the deadline: a short budget a gate comfortably meets is
  // not a reason to stop it, and the envelope still arrives.
  GateSpec g = _printing_an_envelope(Duration.from_secs(2));
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  GateOutput? printed = r.output();
  assert(printed is present, msg: "a gate inside its budget is read rather than stopped");
  assert(r.outcome.to_string() == "measured", msg: "and a short budget it comfortably meets is not a reason to stop it");
  int? code = r.exit_code;
  assert(code is present, msg: "a gate that ended reports a code");
  assert(code! == 0, msg: "and the exit code is the one the kernel gave it");
}

a_gate_with_no_command_for_this_host_could_not_start() `test {
  // A manifest defect, and the outcome says whose it is: nothing ran, and a
  // retry reproduces it forever. Telling this from a gate that printed rubbish
  // used to mean matching on the message text of one shared error type.
  OsOverride[] only_windows = OsOverride[]();
  only_windows.push(OsOverride.of(HostOs.Windows, "make.cmd"));
  VcsTransition[] b = VcsTransition[]();
  b.push(VcsTransition.Commit);
  GateSpec g = GateSpec.of("winonly", OsCommand.dispatched("", move only_windows), none,
                           HostOs[](), none, HostArch[](), Duration.from_secs(60), move b, none,
                           Exclusion[](), string[](), MetricSpec[]());
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.gate == "winonly", msg: "a run that never started still names its gate");
  assert(r.outcome.to_string() == "could not start",
         msg: "no line for this OS is refused rather than run as empty");
  int? code = r.exit_code;
  assert(!(code is present), msg: "and with no process there was never an exit code to have");
  GateOutput? printed = r.output();
  assert(!(printed is present), msg: "nor an envelope");
  string? why = r.detail();
  assert(why is present, msg: "the run says what was wrong with the manifest");
  if why is present {
    // Which host had no line is carried nowhere else: the run names its gate and
    // nothing else, so a detail that omitted it would leave a reader holding a
    // manifest that declares a command, and no way to tell which one was asked for.
    assert(why.contains("linux"), msg: "naming the host it declared no command for: " + why);
  }
}

an_empty_command_line_could_not_start() `test {
  // A line that is not empty and splits to nothing. The same manifest defect
  // as declaring no line at all, and it reaches the same outcome rather than a
  // second error a caller would have to know about separately.
  GateSpec g = _spec("   ");
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "could not start", msg: "a line with no tokens in it names no program");
  int? code = r.exit_code;
  assert(!(code is present), msg: "and nothing ran");
  string? why = r.detail();
  assert(why is present, msg: "the run says what was wrong with the manifest");
}

a_gate_whose_program_is_absent_is_not_yet_could_not_start() `test {
  // The contract's `could not start` is "what the spawn itself reports — the
  // exec syscall refuses a program that is absent or not executable". This
  // runner cannot see that on POSIX: os.Process.spawn succeeds for a missing
  // program and the child exits 127 (os_test.pr, test_execute_nonexistent_
  // program: "the execvp-failure convention"). So the runner observes a process
  // that ran and printed nothing, which is `died` — and the contract forbids
  // reading 127 as the missing program, because 127 is a shell reporting it and
  // the exec line forbids a shell. See promise-language/base#43.
  //
  // This asserts what the runner can actually observe today, so that the day
  // spawn reports the failure this test fails and says so. The spawn handler in
  // run.pr is the correct mapping and does fire where the platform reports it —
  // CreateProcessA does fail for a missing program on Windows.
  GateSpec g = _spec("/nonexistent-directory/no-such-gate");
  GateRun r = run_gate(g, HostOs.Linux, none)?!;
  assert(r.outcome.to_string() == "died", msg: "which is the wrong outcome, and not one this runner can improve on alone");
  int? code = r.exit_code;
  assert(code is present, msg: "because a process did exist");
  assert(code! == 127, msg: "and 127 is the number the contract says a runner must not read as a missing program");
}

a_run_carries_every_field() `test {
  // The tripwire a_clone_carries_every_field is named for, one type over. The
  // factory is positional, so a field added to GateRun changes `of` and this
  // test stops compiling until someone says what the new field reads back as.
  map[string, MetricValue] no_metrics = map[string, MetricValue]();
  GateOutput env = GateOutput.of("linux/amd64", move no_metrics);
  GateRun full = GateRun.of("full", RunOutcome.BrokeContract, 3, "printed a sonnet", move env);

  assert(full.gate == "full", msg: "gate");
  assert(full.outcome.to_string() == "broke the contract", msg: "outcome");
  int? code = full.exit_code;
  assert(code is present, msg: "exit_code survives as present");
  assert(code! == 3, msg: "exit_code");
  string? why = full.detail();
  assert(why is present, msg: "detail survives as present");
  assert(why! == "printed a sonnet", msg: "detail");
  GateOutput? printed = full.output();
  assert(printed is present, msg: "output survives as present");
  if printed is present {
    assert(printed.target == "linux/amd64", msg: "output");
  }

  // And the absences, because they are what the outcome rests on: a run that
  // never started has no code to report and nothing to show, and a sentinel
  // standing in for either is the false reading the outcome exists to replace.
  GateRun bare = GateRun.of("bare", RunOutcome.CouldNotStart, none, none, none);
  int? no_code = bare.exit_code;
  assert(!(no_code is present), msg: "an absent exit_code is absent, not zero");
  string? no_why = bare.detail();
  assert(!(no_why is present), msg: "an absent detail is absent, not empty");
  GateOutput? no_output = bare.output();
  assert(!(no_output is present), msg: "an absent envelope is absent");
}

_every_run_outcome() RunOutcome[] {
  RunOutcome[] all = RunOutcome[]();
  all.push(RunOutcome.Measured);
  all.push(RunOutcome.TimedOut);
  all.push(RunOutcome.CouldNotStart);
  all.push(RunOutcome.Died);
  all.push(RunOutcome.BrokeContract);
  return all;
}

_every_run_spelling() string[] {
  string[] all = string[]();
  all.push("measured");
  all.push("timed out");
  all.push("could not start");
  all.push("died");
  all.push("broke the contract");
  return all;
}

every_run_outcome_is_spelled_as_the_contract_spells_it() `test {
  // Five, and they are the full set — docs/gate-contract.md, "What the gate
  // runner reports". The rendering is what a reader sees and what two outcomes
  // are compared by, an enum satisfying neither Hashable nor Equal, so a
  // spelling that drifts from the document is a real divergence rather than a
  // cosmetic one.
  RunOutcome[] every = _every_run_outcome();
  string[] spellings = _every_run_spelling();
  assert(every.len == 5, msg: "the set is five");
  assert(spellings.len == every.len, msg: "and one spelling per outcome");
  bool every_one = true;
  int i = 0;
  while i < every.len {
    RunOutcome one = every[i];
    string want = spellings[i];
    if one.to_string() != want {
      every_one = false;
    }
    i = i + 1;
  }
  assert(every_one, msg: "each outcome renders as the word the contract uses for it");
}
